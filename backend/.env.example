# National Weather Intelligence Platform - Environment Variables
PROJECT_NAME="National Weather Big Data Analytics Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="weather_user"
POSTGRES_PASSWORD="weather_password"
POSTGRES_DB="weather_db"
DATABASE_URL="sqlite:///./weather_intelligence.db"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_RAW_TOPIC="observations.raw"
KAFKA_NORMALIZED_TOPIC="observations.normalized"
KAFKA_FEATURES_TOPIC="observations.features"
KAFKA_EVENTS_TOPIC="weather.events"
KAFKA_ALERTS_TOPIC="weather.alerts"

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="weather-observations"

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI="http://localhost:5000"

# Triton Inference Server
TRITON_SERVER_URL="localhost:8001"

# JWT Security
SECRET_KEY="supersecretkey-for-national-weather-platform-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480
